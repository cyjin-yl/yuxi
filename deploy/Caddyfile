yvxi.cyjin.dev {
	tls /etc/caddy/certs/yvxi.cyjin.dev.crt /etc/caddy/certs/yvxi.cyjin.dev.key
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	redir /songs /collections/ 301
	redir /songs/* /collections/ 301
	redir /blog/2026-08-31-tech-notes /blog/2026-08-31-discord-50083-io-reader-corruption/ 308
	redir /blog/2026-08-31-tech-notes/ /blog/2026-08-31-discord-50083-io-reader-corruption/ 308

	@backend path /netease/* /audio/* /api/health
	handle @backend {
		reverse_proxy 127.0.0.1:8787
	}

	handle /song/* {
		root * /srv/yuxi/current/site
		try_files {path} {path}/index.html /song/0/index.html
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	handle {
		root * /srv/yuxi/current/site
		header Cache-Control "public, max-age=60, must-revalidate"
		@immutable path /_astro/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}

