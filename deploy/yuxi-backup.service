[Unit]
Description=Yuxi SQLite online recovery set
After=yuxi-backend.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/yuxi-backup.py
Environment=YUXI_DB=/var/lib/yuxi/yuxi.sqlite
Environment=YUXI_KEY_FILE=/var/lib/yuxi/session.key
Environment=YUXI_BACKUP_DIR=/var/backups/yuxi
Environment=YUXI_BACKUP_KEEP=14
EnvironmentFile=-/etc/yuxi/backup.env
UMask=0077
TimeoutStartSec=6min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/yuxi
ReadWritePaths=/var/backups/yuxi
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
