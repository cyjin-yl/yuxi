[Unit]
Description=Hermes NetEase cache service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
EnvironmentFile=/etc/hermes/netease.env
ExecStart=/usr/bin/python3 /opt/hermes-netease/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes/netease
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
