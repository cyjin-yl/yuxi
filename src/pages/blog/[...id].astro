---
import PostLayout from '../../layouts/post.astro';
import { render } from 'astro:content';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout
  headings={headings}
  title={post.data.title}
  date={post.data.date}
  tags={post.data.tags ?? []}
  description={post.data.description}
  luogu_url={post.data.luogu_url}
  luogu_title={post.data.luogu_title}
  difficulty={post.data.difficulty}
  algo_tags={post.data.algo_tags}
  summary={post.data.summary}
  widget={post.data.widget}
  self_review={post.data.self_review}
  backfilledAt={post.data.backfilledAt}
  backfillKind={post.data.backfillKind}
  hasMath={/\$|\\\(|\\\[/.test(post.body ?? '')}
>
  <Content />
</PostLayout>
