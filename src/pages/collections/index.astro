---
import '../../styles/music.css';
import BaseLayout from '../../layouts/base.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import classics from '../../data/classic-songs.json';
const publicPlaylists = [{ id: '19723756', name: '飙升榜' }, { id: '3778678', name: '热歌榜' }];
---

<BaseLayout title="曲库" description="听原来的 40 首英语歌，搜索网易云音乐，或打开一张公开歌单。">
  <Header currentPath="/collections/" />

  <main id="main" class="home home-wide music-page">
    <div class="home-intro">
      <h1>曲库</h1>
      <p>这里留着原来的 40 首英语歌，也能搜网易云里的歌曲、打开公开歌单。喜欢的歌会留在这个浏览器里。</p>
    </div>

    <section class="netease-section" id="music-browser" aria-labelledby="online-music-heading">
      <h2 class="netease-section-title" id="online-music-heading">找点音乐</h2>
      <form id="music-search-form" class="music-form">
        <label for="music-search-query">搜索歌曲或歌手</label>
        <div class="music-form-row">
          <input id="music-search-query" name="q" type="search" required maxlength="100" placeholder="歌名、歌手…" aria-describedby="music-search-status" />
          <button class="collection-btn" type="submit">搜索</button>
        </div>
      </form>
      <p id="music-search-status" class="netease-loading" role="status"></p>
      <div id="music-search-results" class="netease-grid"></div>
      <form id="public-playlist-form" class="music-form">
        <label for="public-playlist-input">打开公开歌单</label>
        <div class="music-form-row">
          <input id="public-playlist-input" name="playlist" type="text" required maxlength="1000" placeholder="粘贴网易云歌单链接或 ID" aria-describedby="public-playlist-status" />
          <button class="collection-btn" type="submit">打开歌单</button>
        </div>
      </form>
      <p id="public-playlist-status" class="netease-loading" role="status"></p>
      <div id="public-playlist-result" class="netease-grid">
        {publicPlaylists.map((playlist) => (
          <button type="button" class="netease-card" data-play-netease-playlist={playlist.id} aria-label={`播放${playlist.name}`}>
            <span class="netease-cover-wrap music-cover-empty" aria-hidden="true">♫</span>
            <span class="netease-title-marquee"><span class="netease-title-text">{playlist.name}</span></span>
            <span class="local-likes-sub">网易云公开榜单</span>
          </button>
        ))}
      </div>
    </section>

    <section class="netease-section classics-section" id="classics" aria-labelledby="classics-heading">
      <div class="classics-heading">
        <div>
          <h2 class="netease-section-title" id="classics-heading">经典英语歌曲 · 40 首</h2>
          <p class="netease-section-note">原来的录音已经搬回来，点开就能听。</p>
        </div>
        <button class="collection-btn" type="button" data-play-collection="classic-songs">播放全部</button>
      </div>
      <ol class="classics-list">
        {classics.map((song) => (
          <li>
            <button type="button" data-play-track={song.id} data-collection="classic-songs" aria-label={`播放 ${song.title}`}>
              <span class="classics-number" aria-hidden="true">{String(song.number).padStart(2, '0')}</span>
              <span><strong>{song.title}</strong><small>{song.artist}</small></span>
              <span class="classics-play" aria-hidden="true">▶</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="netease-section local-likes-section" aria-label="我喜欢的音乐" id="local-likes-section" hidden>
      <h2 class="netease-section-title">我喜欢的音乐</h2>
      <p class="netease-section-note">收藏保存在当前浏览器，清除网站数据后会一并删除。</p>
      <div id="local-likes-grid" class="netease-grid"></div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .classics-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .classics-heading .collection-btn { flex-shrink: 0; }
  .classics-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem 1.5rem; }
  .classics-list button { width: 100%; display: flex; align-items: center; gap: .8rem; padding: .85rem .55rem; border: 0; border-radius: .5rem; color: inherit; background: transparent; text-align: left; cursor: pointer; }
  .classics-list button:hover, .classics-list button:focus-visible { background: color-mix(in srgb, currentColor 7%, transparent); }
  .classics-list button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .classics-number { opacity: .55; font-variant-numeric: tabular-nums; }
  .classics-list strong { display: block; font-size: .95rem; font-weight: 500; }
  .classics-list small { display: block; opacity: .65; font-size: .8rem; margin-top: .15rem; }
  .classics-play { margin-left: auto; font-size: .75rem; opacity: .65; }
  @media (max-width: 640px) { .classics-list { grid-template-columns: 1fr; } .classics-heading { align-items: flex-start; } }
</style>

<script>
  import { setupMusicBrowser } from '../../lib/music-browser';
  setupMusicBrowser();
  document.addEventListener('astro:page-load', setupMusicBrowser);
</script>
