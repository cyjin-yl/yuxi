---
interface PostItem {
  id: string;
  data: {
    title: string;
    description?: string;
    date: Date;
    tags?: string[];
  };
}

interface Props {
  posts: PostItem[];
  base?: string;
}

const { posts, base = '/blog' } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}
---

{
  posts.length === 0 ? (
    <p class="page-lede">暂无文章。</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <a class="post-item-link" href={`${base}/${post.id}/`}>
            <div class="post-item-title">{post.data.title}</div>
            <div class="post-item-meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              {post.data.tags?.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {post.data.description && <p class="post-item-desc">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  )
}
