---
import '../styles/global.css';
import katexStyles from 'katex/dist/katex.min.css?url';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  tags?: string[];
  date?: Date;
  hasMath?: boolean;
}

const {
  title,
  description = '余隙的笔记本。写算法、写数学、写思考过程。',
  tags = [],
  date,
  hasMath = false,
} = Astro.props;

const siteName = '余隙';
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · 安静地写，慢慢地读`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://yvxi.cyjin.dev').href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1816" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="余隙" href="/rss.xml" />
    {hasMath && <link rel="stylesheet" href={katexStyles} />}
    <meta property="og:type" content={date ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="none" />
    <script is:inline>
      (function () {
        // Always pin an explicit data-theme before first paint so the system
        // prefers-color-scheme media query cannot flash-override a stored choice.
        function resolveTheme() {
          try {
            var stored = localStorage.getItem('yuxi-theme');
            if (stored === 'light' || stored === 'dark') return stored;
          } catch (_) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        try {
          document.documentElement.setAttribute('data-theme', resolveTheme());
        } catch (_) {}
        // Re-apply after ClientRouter swaps so a manual choice never snaps back
        // to the OS preference on route change.
        document.addEventListener('astro:after-swap', function () {
          try {
            document.documentElement.setAttribute('data-theme', resolveTheme());
          } catch (_) {}
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <div class="site-shell">
      <slot />
    </div>
    <div id="player-root" transition:persist="player-shell"></div>
    <p id="player-status" class="sr-only" role="status" aria-live="polite"></p>
    <script>
      import '../lib/player/loader';
    </script>
    <dialog class="zoom-overlay" id="zoomOverlay" aria-label="图片预览">
      <button type="button" class="zoom-close" aria-label="关闭图片预览">×</button>
      <img id="zoomImage" alt="" />
    </dialog>

    <script>
      // Delegation survives ClientRouter navigation and does not retain old pages.
      document.addEventListener('click', (event) => {
        const target = event.target;
        const dialog = document.getElementById('zoomOverlay') as HTMLDialogElement | null;
        const preview = document.getElementById('zoomImage') as HTMLImageElement | null;
        if (!dialog || !preview || !(target instanceof Element)) return;
        if (target === dialog || target.closest('.zoom-close')) {
          dialog.close();
          return;
        }
        if (target instanceof HTMLImageElement && target.classList.contains('zoomable')) {
          preview.src = target.currentSrc || target.src;
          preview.alt = target.alt;
          dialog.showModal();
        }
      });
      document.addEventListener('keydown', (event) => {
        if ((event.key === 'Enter' || event.key === ' ') && event.target instanceof HTMLImageElement && event.target.classList.contains('zoomable')) {
          event.preventDefault();
          event.target.click();
        }
      });
      async function preparePage() {
        document.querySelectorAll<HTMLImageElement>('.zoomable').forEach((img) => {
          img.tabIndex = 0;
          img.setAttribute('role', 'button');
          img.setAttribute('aria-label', `放大图片：${img.alt || '文章配图'}`);
        });
        const nodes = [...document.querySelectorAll<HTMLElement>('.mermaid:not([data-processed])')];
        if (nodes.length) {
          const { default: mermaid } = await import('mermaid');
          mermaid.initialize({ startOnLoad: false, theme: 'neutral', securityLevel: 'strict' });
          await mermaid.run({ nodes });
        }
      }
      document.addEventListener('astro:page-load', () => { void preparePage(); });
      void preparePage();
    </script>
  </body>
</html>
