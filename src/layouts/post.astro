---
import BaseLayout from './base.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import widgetStyles from '../styles/widgets.css?url';

interface Props {
  title: string;
  hasMath?: boolean;
  backfilledAt?: Date;
  backfillKind?: 'event' | 'retrospective';
  headings?: { depth: number; slug: string; text: string }[];
  date: Date;
  tags?: string[];
  description?: string;
  luogu_url?: string;
  luogu_title?: string;
  difficulty?: string;
  algo_tags?: string[];
  summary?: string;
  self_review?: string;
  /** Optional embedded widget key (rendered by MDX components, not the layout). */
  widget?: string;
}

const {
  title,
  date,
  tags = [],
  description,
  luogu_url,
  luogu_title,
  difficulty,
  algo_tags,
  summary,
  self_review,
  hasMath = false,
  backfilledAt,
  backfillKind,
  headings = [],
} = Astro.props;

const outline = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasTOC = outline.length > 0;
const dateLabel = (value: Date) => value.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai' });

function difficultyLabel(d: string) {
  if (d === 'puji') return '普及';
  if (d === 'tigao') return '提高';
  if (d === 'shengxuan') return '省选';
  return '未知';
}
---

<BaseLayout title={title} tags={tags} date={backfilledAt ?? date} description={description} hasMath={hasMath}>
  {luogu_url && <link rel="stylesheet" href={widgetStyles} />}
  <Header currentPath="/blog/" />

  <main id="main" class:list={['post-page', { 'has-toc': hasTOC }]}>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>
          {
            date.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
              timeZone: 'Asia/Shanghai',
            })
          }
        </time>
        {
          tags.map((tag: string) => (
            <a href={`/tags/${tag}/`} class="tag">
              {tag}
            </a>
          ))
        }
      </div>
      {backfilledAt && (
        <p class="post-backfill-note">
          整理于 <time datetime={backfilledAt.toISOString()}>{dateLabel(backfilledAt)}</time>
          {backfillKind === 'retrospective' ? ' · 主题回顾' : ''}
        </p>
      )}
    </header>

    {
      luogu_url && (
        <div class="post-widget">
          <div class="luogu-header">
            <div class="luogu-title-row">
              <span class="luogu-problem-name">{luogu_title || title}</span>
              <a class="luogu-link" href={luogu_url} target="_blank" rel="noopener noreferrer">
                洛谷原题
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
            <div class="luogu-meta">
              {difficulty && (
                <span class={`luogu-diff diff-${difficulty}`}>{difficultyLabel(difficulty)}</span>
              )}
              {algo_tags?.map((tag: string) => (
                <span class="luogu-tag">{tag}</span>
              ))}
            </div>
            {summary && <p class="luogu-summary">{summary}</p>}
          </div>
        </div>
      )
    }

    <div class:list={['post-wrapper', { 'has-toc': hasTOC }]}>
      <article class="prose" id="post-content">
        <slot />
      </article>

      {
        hasTOC && (
          <div class="toc-sticky-wrapper" id="toc-wrap" hidden>
            <div class="toc-backdrop" id="toc-backdrop" hidden></div>
            <aside class="toc-sidebar" id="toc-sidebar" aria-label="文章目录">
              <div class="toc-header">
                <h3>目录</h3>
                <button type="button" class="toc-toggle" id="toc-close" aria-label="关闭目录">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <div class="toc-scroll">
                <nav class="toc-list" id="toc-list">
                  <ol>{outline.map((heading) => (
                    <li class:list={[{ 'toc-h3': heading.depth === 3 }]}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}</ol>
                </nav>
              </div>
            </aside>
          </div>
        )
      }
    </div>

    {
      self_review && (
        <div class="self-review">
          <h3>余隙 Self-Review</h3>
          <div class="self-review-content">
            {self_review.split('\n').map((line: string) => (line ? <p>{line}</p> : undefined))}
          </div>
          <p class="self-review-sign">— 余隙</p>
        </div>
      )
    }

  </main>

  {
    hasTOC && (
      <button type="button" class="toc-mobile-toggle" id="toc-open" aria-label="打开目录" aria-controls="toc-sidebar" aria-expanded="false" hidden>
        目
      </button>
    )
  }

  <Footer />
</BaseLayout>

<script>
  let cleanup = () => {};

  function prepareContents() {
    cleanup();
    const content = document.getElementById('post-content');
    const list = document.getElementById('toc-list');
    const wrap = document.getElementById('toc-wrap');
    const sidebar = document.getElementById('toc-sidebar');
    const open = document.getElementById('toc-open');
    const close = document.getElementById('toc-close');
    const backdrop = document.getElementById('toc-backdrop');
    if (!content || !list || !wrap) return;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    const headings = content.querySelectorAll('h2[id], h3[id]');
    wrap.hidden = false;
    if (open) open.hidden = false;
    if (backdrop) backdrop.hidden = false;

    function closeDrawer(restoreFocus = true) {
      wrap!.classList.remove('open');
      document.documentElement.style.overflow = '';
      open?.setAttribute('aria-expanded', 'false');
      sidebar?.removeAttribute('role');
      sidebar?.removeAttribute('aria-modal');
      if (restoreFocus) open?.focus();
    }
    open?.addEventListener('click', () => {
      wrap.classList.add('open');
      document.documentElement.style.overflow = 'hidden';
      open.setAttribute('aria-expanded', 'true');
      sidebar?.setAttribute('role', 'dialog');
      sidebar?.setAttribute('aria-modal', 'true');
      close?.focus();
    }, options);
    close?.addEventListener('click', () => closeDrawer(), options);
    backdrop?.addEventListener('click', () => closeDrawer(), options);
    document.addEventListener('keydown', (event) => {
      if (!wrap.classList.contains('open')) return;
      if (event.key === 'Escape') closeDrawer();
      if (event.key === 'Tab' && sidebar) {
        const items = [...sidebar.querySelectorAll<HTMLElement>('button, a[href]')];
        const first = items[0], last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    }, options);
    list.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
      const id = link?.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (!target) return;
      event.preventDefault();
      if (window.matchMedia('(max-width: 1099px)').matches) closeDrawer(false);
      target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${encodeURIComponent(id!)}`);
    }, options);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        list.querySelectorAll('a').forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`));
      }
    }, { rootMargin: '-20% 0px -70% 0px' });
    headings.forEach((heading) => observer.observe(heading));
    cleanup = () => { controller.abort(); observer.disconnect(); closeDrawer(false); };
  }
  document.addEventListener('astro:page-load', prepareContents);
  document.addEventListener('astro:before-swap', () => cleanup());
  prepareContents();
</script>
