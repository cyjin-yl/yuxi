---
import BaseLayout from './base.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  luogu_url?: string;
  luogu_title?: string;
  difficulty?: string;
  algo_tags?: string[];
  summary?: string;
  self_review?: string;
}

const {
  title,
  date,
  tags = [],
  description,
  luogu_url,
  luogu_title,
  difficulty,
  algo_tags,
  summary,
  self_review,
} = Astro.props;

const hasTOC = true;

function difficultyLabel(d: string) {
  if (d === 'puji') return '普及';
  if (d === 'tigao') return '提高';
  if (d === 'shengxuan') return '省选';
  return '未知';
}
---

<BaseLayout title={title} tags={tags} date={date} description={description}>
  <Header currentPath="/blog/" />

  <main id="main">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>
          {
            date.toLocaleDateString('zh-CN', {
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
            })
          }
        </time>
        {
          tags.map((tag: string) => (
            <a href={`/tags/${tag}/`} class="tag">
              {tag}
            </a>
          ))
        }
      </div>
    </header>

    {
      luogu_url && (
        <div class="post-widget">
          <div class="luogu-header">
            <div class="luogu-title-row">
              <span class="luogu-problem-name">{luogu_title || title}</span>
              <a class="luogu-link" href={luogu_url} target="_blank" rel="noopener noreferrer">
                洛谷原题
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </div>
            <div class="luogu-meta">
              {difficulty && (
                <span class={`luogu-diff diff-${difficulty}`}>{difficultyLabel(difficulty)}</span>
              )}
              {algo_tags?.map((tag: string) => (
                <span class="luogu-tag">{tag}</span>
              ))}
            </div>
            {summary && <p class="luogu-summary">{summary}</p>}
          </div>
        </div>
      )
    }

    <div class="post-wrapper">
      <article class="prose" id="post-content">
        <slot />
      </article>

      {
        hasTOC && (
          <div class="toc-sticky-wrapper" id="toc-wrap" hidden>
            <div class="toc-backdrop" id="toc-backdrop" hidden></div>
            <aside class="toc-sidebar" id="toc-sidebar" aria-label="文章目录">
              <div class="toc-header">
                <h3>目录</h3>
                <button type="button" class="toc-toggle" id="toc-close" aria-label="关闭目录">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                  </svg>
                </button>
              </div>
              <div class="toc-scroll">
                <nav class="toc-list" id="toc-list"></nav>
              </div>
            </aside>
          </div>
        )
      }
    </div>

    {
      self_review && (
        <div class="self-review">
          <h3>余隙 Self-Review</h3>
          <div class="self-review-content">
            {self_review.split('\n').map((line: string) => (line ? <p>{line}</p> : undefined))}
          </div>
          <p class="self-review-sign">— 余隙</p>
        </div>
      )
    }

  </main>

  {
    hasTOC && (
      <button type="button" class="toc-mobile-toggle" id="toc-open" aria-label="打开目录" hidden>
        目
      </button>
    )
  }

  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const content = document.getElementById('post-content');
    const tocList = document.getElementById('toc-list');
    const tocWrap = document.getElementById('toc-wrap');
    const tocSidebar = document.getElementById('toc-sidebar');
    const tocOpen = document.getElementById('toc-open');
    const tocClose = document.getElementById('toc-close');
    const tocBackdrop = document.getElementById('toc-backdrop');
    if (!content || !tocList || !tocWrap) return;

    const headings = content.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      tocWrap.remove();
      tocOpen?.remove();
      return;
    }

    const items = [];
    headings.forEach((h, i) => {
      if (!h.id) {
        const base =
          (h.textContent || 'section')
            .trim()
            .toLowerCase()
            .replace(/[^\w\u4e00-\u9fff]+/g, '-')
            .replace(/^-+|-+$/g, '') || `h-${i}`;
        h.id = base;
      }
      items.push({
        id: h.id,
        text: (h.textContent || '').trim(),
        level: h.tagName === 'H2' ? 2 : 3,
      });
    });

    let html = '<ol>';
    items.forEach((item) => {
      const cls = item.level === 3 ? ' class="toc-h3"' : '';
      html += `<li${cls}><a href="#${item.id}">${item.text}</a></li>`;
    });
    html += '</ol>';
    tocList.innerHTML = html;

    tocWrap.hidden = false;
    if (tocOpen) tocOpen.hidden = false;
    if (tocBackdrop) tocBackdrop.hidden = false;

    function openDrawer() {
      tocWrap.classList.add('open');
      document.documentElement.style.overflow = 'hidden';
      tocClose?.focus();
    }

    function closeDrawer() {
      tocWrap.classList.remove('open');
      document.documentElement.style.overflow = '';
    }

    tocOpen?.addEventListener('click', openDrawer);
    tocClose?.addEventListener('click', closeDrawer);
    tocBackdrop?.addEventListener('click', closeDrawer);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && tocWrap.classList.contains('open')) closeDrawer();
    });

    tocList.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', (e) => {
        const id = a.getAttribute('href')?.slice(1) || '';
        const target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
        if (window.matchMedia('(max-width: 1099px)').matches) closeDrawer();
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          const link = tocList.querySelector(`a[href="#${CSS.escape(id)}"]`);
          if (!link) return;
          tocList.querySelectorAll('a').forEach((l) => l.classList.remove('active'));
          link.classList.add('active');
        });
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    headings.forEach((h) => observer.observe(h));
  });
</script>
