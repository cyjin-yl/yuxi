{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yvxi-party",
  "main": "workers/worker.ts",
  "compatibility_date": "2026-07-24",
  "durable_objects": {
    "bindings": [
      { "name": "PARTY_ROOM", "class_name": "PartyRoomDO" },
      { "name": "PARTY_INDEX", "class_name": "PartyIndexDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PartyRoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PartyIndexDO"] }
  ]
}
